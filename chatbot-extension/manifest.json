{
  "manifest_version": 3,
  "name": "Chatbot Extension",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "css": ["style.css"] }
  ],
  "icons": { "128": "icon.png" }
}
